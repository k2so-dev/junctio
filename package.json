{
  "name": "junctio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/gateway/src/cli/index.ts serve",
    "start": "bun apps/gateway/src/cli/index.ts serve",
    "dev:web": "bun --cwd apps/web run dev",
    "build:web": "bun --cwd apps/web run build",
    "test": "bun test",
    "typecheck": "bun run --cwd apps/gateway typecheck",
    "db:generate": "bun run --cwd apps/gateway db:generate"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
