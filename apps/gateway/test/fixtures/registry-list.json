      "server": {
        "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
        "name": "io.github.j0hanz/filesystem-mcp",
        "description": "Secure filesystem MCP server for reading, writing, searching, diffing, and patching files.",
        "title": "Filesystem MCP",
        "repository": {
          "url": "https://github.com/j0hanz/filesystem-mcp",
          "source": "github",
          "id": "1115057681"
        },
        "version": "2.2.0",
        "websiteUrl": "https://github.com/j0hanz/filesystem-mcp",
        "packages": [
          {
            "registryType": "npm",
            "identifier": "@j0hanz/filesystem-mcp",
            "version": "2.2.0",
            "runtimeHint": "npx",
            "transport": {
              "type": "stdio"
            },
            "packageArguments": [
              {
                "description": "Directory path the server is allowed to access. Repeat for multiple directories.",
                "format": "filepath",
                "type": "positional",
                "valueHint": "allowed_directory",
                "isRepeated": true
              },
              {
                "description": "Allow the current working directory as an additional access root.",
                "format": "boolean",
                "type": "named",
                "name": "--allow-cwd"
              },
              {
                "description": "Disable all write, edit, move, and delete tools.",
                "format": "boolean",
                "type": "named",
                "name": "--read-only"
              }
            ],
            "environmentVariables": [
              {
                "description": "Allowed directories; ':'-separated on Unix, ';'-separated on Windows. Alternative to positional arguments.",
                "format": "string",
                "name": "FS_ALLOWED_DIRS"
              }
            ]
          },
          {
            "registryType": "oci",
            "identifier": "ghcr.io/j0hanz/filesystem-mcp:2.2.0",
            "runtimeHint": "docker",
            "transport": {
              "type": "stdio"
            },
            "runtimeArguments": [
              {
                "description": "Keep stdin open for stdio transport.",
                "isRequired": true,
                "format": "boolean",
                "type": "named",
                "name": "-i"
              },
              {
                "description": "Remove the container on exit.",
                "isRequired": true,
                "format": "boolean",
                "type": "named",
                "name": "--rm"
              },
              {
                "description": "Mount the directory to expose to the server.",
                "isRequired": true,
                "value": "{host_dir}:/workspace:ro",
                "variables": {
                  "host_dir": {
                    "description": "Host directory path to expose to the server.",
                    "isRequired": true,
                    "format": "filepath"
                  }
                },
                "type": "named",
                "name": "-v",
                "isRepeated": true
              }
            ],
            "packageArguments": [
              {
                "description": "Container path of the mounted directory.",
                "isRequired": true,
                "default": "/workspace",
                "type": "positional",
                "valueHint": "/workspace"
              }
            ],
            "environmentVariables": [
              {
                "description": "Allowed directories inside the container, ':'-separated. Alternative to positional arguments.",
                "format": "string",
                "name": "FS_ALLOWED_DIRS"
              }
            ]
          }
        ]
      },
