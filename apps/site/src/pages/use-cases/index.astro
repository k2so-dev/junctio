---
import Base from "@/layouts/Base.astro";
import UseCaseCard from "@/components/UseCaseCard.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("useCases")).sort((a, b) => a.data.order - b.data.order);

const groups = [
  {
    id: "client",
    title: "Connect a client",
    text: "One page per client and per way of hosting it: the endpoint, the auth mode, and what the gateway does for you once it is in place."
  },
  {
    id: "agent",
    title: "Give the agent hands",
    text: "The gateway is the OAuth door for claude.ai, Claude Desktop, Codex and Claude Code. Behind it, anything with an API becomes tools the agent can call."
  }
];
---

<Base
  title="Use cases"
  description="Put Junctio in front of Claude Code, Cursor, claude.ai and a small team, or behind it a Dokploy deploy platform, any OpenAPI service and a 3x-ui panel."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-semibold tracking-tight">Use cases</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      Each page is one setup, end to end: what you connect, how it authenticates, and where it stops.
    </p>
    {
      groups.map((group) => (
        <div class="mt-12">
          <h2 class="text-xl font-semibold tracking-tight">{group.title}</h2>
          <p class="mt-2 max-w-2xl text-sm text-muted-foreground">{group.text}</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {entries
              .filter((entry) => entry.data.group === group.id)
              .map((entry) => (
                <UseCaseCard entry={entry} detailed />
              ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>
