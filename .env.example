# at least 32 characters, e.g. openssl rand -hex 32
JUNCTIO_SECRET=
JUNCTIO_BASE_URL=https://mcp.example.com
JUNCTIO_ADMIN_TOKEN=
JUNCTIO_OAUTH_ISSUER=
JUNCTIO_OAUTH_AUDIENCE=
# only for a source-tree run; the image already points this at the /data volume
JUNCTIO_DATA_DIR=./data
JUNCTIO_DOCKER_SOCKET=/var/run/docker.sock
JUNCTIO_TRUST_PROXY=false
PORT=3000
LOG_LEVEL=info
